{
  "name": "dinetogether",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c auto \"node --watch server/index.mjs --port 8791\" \"vite\"",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "share": "vite build && node scripts/share.mjs",
    "share:online": "vite build && node scripts/share-online.mjs"
  },
  "dependencies": {
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "cloudflared": "^0.7.3",
    "concurrently": "^9.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Plan a group dinner together: everyone picks food from what is available within 12 km, with live totals."
}
